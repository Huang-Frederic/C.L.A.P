# Copie ce fichier en .env et adapte les valeurs. Le .env n'est jamais commité.

# --- CapCut ---------------------------------------------------------------
# CapCut > Paramètres > Emplacement des brouillons (valeur par défaut sous Windows ci-dessous, à vérifier)
CAPCUT_DRAFTS_DIR=${LOCALAPPDATA}\CapCut\User Data\Projects\com.lveditor.draft

# --- Dossiers -------------------------------------------------------------
# Dossier de rushs utilisé par défaut (smoke-test, analyze)
CLAP_RUSHES_DIR=D:\dji_temp\ski_huang_2026
# Sorties (rushes.json, planches contact, EDL) et cache (proxies, embeddings)
CLAP_OUTPUT_DIR=output
CLAP_CACHE_DIR=cache

# --- Claude (mode 100 % automatique via l'API, optionnel) ------------------
# Inutile si tu passes par ton abonnement (Claude Desktop / Claude Code + MCP)
ANTHROPIC_API_KEY=
CLAP_CLAUDE_MODEL=claude-haiku-5-5

# --- Analyse --------------------------------------------------------------
# tiny | base | small | medium | large-v3 (small tient bien sur une RTX 3070)
CLAP_WHISPER_MODEL=small
# cuda | cpu
CLAP_DEVICE=cuda
